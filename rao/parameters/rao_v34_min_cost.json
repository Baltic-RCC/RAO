{
  "version": "3.4",
  "objective-function": { "type": "MIN_COST" },
  "range-actions-optimization": { "injection-ra-min-impact-threshold": 0.001 },
  "extensions": {
    "open-rao-search-tree-parameters": {
      "range-actions-optimization": {
        "max-mip-iterations": 5,
        "injection-ra-sensitivity-threshold": 0.001,
        "pst-model": "APPROXIMATED_INTEGERS",
        "linear-optimization-solver": { "solver": "CBC" }
      },
      "load-flow-and-sensitivity-computation": {
        "load-flow-provider": "OpenLoadFlow",
        "sensitivity-provider": "OpenLoadFlow",
        "sensitivity-parameters": { "version": "1.3",
          "load-flow-parameters": { "version": "1.11", "dc": true } }
      },
      "costly-min-margin-parameters": {
        "shifted-violation-penalty": 10000.0,
        "shifted-violation-threshold": 5.0
      }
    }
  }
}
