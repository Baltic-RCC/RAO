# Example of local configuration for debugging.
# Copy this file to config/.env and fill in the values. config/.env is ignored by git and docker.
#
# Every setting can also be given as an environment variable of the same name, which takes precedence
# over this file. Lines left commented out or empty fall back to the defaults in config/settings.py
# and the service settings.py modules.

# --- Logging ---
# LOG_LEVEL=20                      # number (10, 20, ...) or name (DEBUG, INFO, ...)
# FORWARD_STD_LOGS=True
# ENABLE_POWSYBL_LOGS=False
# EXCLUDE_LOGGERS=pika              # comma separated logger names
# ENQUEUE=False
# CATCH=False
# ELASTIC_LOGS_HANDLER=False
# ELASTIC_LOGS_INDEX=rao-logs

# --- Elasticsearch ---
ELK_SERVER=https://elastic.example.com:9200
ELK_TOKEN=<elastic-api-key>
ELK_SSL_VERIFY=False
# BATCH_SIZE=20000
# When ELK_SSL_VERIFY=True, SSL_CERT_FILE must be set as a real environment variable (it is not read from this file)

# --- MinIO (required) ---
MINIO_SERVER=minio.example.com
MINIO_USERNAME=<ldap-username>
MINIO_PASSWORD=<ldap-password>
# TOKEN_EXPIRATION=86400
# TOKEN_RENEW_MARGIN=120
# MAXSIZE=50

# --- RabbitMQ (required) ---
RMQ_SERVER=rabbitmq.example.com
RMQ_PORT=5672
RMQ_VHOST=/
RMQ_USERNAME=<rmq-username>
RMQ_PASSWORD=<rmq-password>
# RMQ_HEARTBEAT=15

# --- Object storage ---
# S3_BUCKET_OUT=pdn-data
# S3_BUCKET_OUT_PREFIX=CSA
# S3_BUCKET_IN_MODELS=opde-confidential-models
# ELASTIC_METADATA_INDEX=csa-input-metadata
# ELASTIC_MODELS_INDEX=emfos-merge-reports

# --- Worker consumer (default queue differs per worker) ---
# RMQ_QUEUE_IN=rao.violations
# CONSUMER_TYPE=SINGLE_MESSAGE      # rao workers only: SINGLE_MESSAGE or LONG_LIVING
# ENABLE_DATA_STORAGE_HANDLER=False # input_retriever only

# --- RAO handlers ---
# OPTIMIZE_ONLY_CURRENT_VIOLATIONS=True
# CRAC_USE_LIMITS_FROM_MODEL=True
# VIOLATION_THRESHOLD_PERCENT=100
# CONTINGENCIES_COUNT_THRESHOLD=10
# S3_PREPARED_MODEL_PREFIX=RAO
# ELASTIC_RESULTS_INDEX=rao-results
# ELASTIC_VOLTAGE_RESULTS_INDEX=rao-voltage-results
# S3_BUCKET_RESULTS=opde-confidential-analyses
# DEBUG=False

# --- input_retriever / remedial_action_schedules handlers ---
# CONVERTER_KEY_MODE=local
# ELASTIC_CONTINGENCIES_INDEX=csa-contingencies
# ELASTIC_ASSESSED_ELEMENTS_INDEX=csa-assessed-elements
# ELASTIC_REMEDIAL_ACTIONS_INDEX=csa-remedial-actions
# ELASTIC_SCHEDULES_INDEX=csa-optimized-schedules
